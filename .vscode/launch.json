{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to PostgreSQL",
            "type": "cppdbg",
            "request": "attach",
            "program": "/usr/lib/postgresql/17/bin/postgres",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}